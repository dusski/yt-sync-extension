rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: groups
    // Document ID: Random 6-character string (Sync Code)
    // Fields:
    //   - members: list of strings (UIDs)
    //   - createdAt: timestamp
    //
    // Collection: groups/{groupId}/videos
    // Document ID: YouTube Video ID
    // Fields:
    //   - videoId: string
    //   - title: string
    //   - thumbnail: string
    //   - progress: number (seconds)
    //   - lastUpdated: timestamp
    //   - lastUpdatedBy: string (UID)
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isGroupMember(groupId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    match /groups/{groupId} {
      allow create: if isAuthenticated() 
                    && request.resource.data.keys().hasAll(['members', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['members', 'createdAt'])
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members is list
                    && request.resource.data.members.size() <= 10;
                    
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && request.auth.uid in resource.data.members;
      
      // Allow joining if you know the groupId
      allow update: if isAuthenticated() 
                    && request.resource.data.keys().hasAll(['members', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['members', 'createdAt'])
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.members is list
                    && request.resource.data.members.size() <= 10
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.hasAll(resource.data.members);

      match /videos/{videoId} {
        allow read: if isGroupMember(groupId);
        
        allow create, update: if isGroupMember(groupId)
                              && request.resource.data.keys().hasAll(['videoId', 'title', 'thumbnail', 'progress', 'lastUpdated', 'lastUpdatedBy'])
                              && request.resource.data.keys().hasOnly(['videoId', 'title', 'thumbnail', 'progress', 'lastUpdated', 'lastUpdatedBy'])
                              && request.resource.data.videoId is string && request.resource.data.videoId.size() < 50
                              && request.resource.data.title is string && request.resource.data.title.size() < 200
                              && request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() < 500
                              && request.resource.data.progress is number && request.resource.data.progress >= 0
                              && request.resource.data.lastUpdatedBy == request.auth.uid;
      }
    }
  }
}
